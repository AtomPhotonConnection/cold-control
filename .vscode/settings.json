{
    "python-envs.defaultEnvManager": "ms-python.python:conda",
    "python-envs.defaultPackageManager": "ms-python.python:conda",
    "editor.formatOnSave": true,
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "editor.source.FixAll": "explicit",
            "editor.source.organizeImports": "explicit"
        }
    },
    "ruff.lint.enable": true,
    "python.analysis.autoImportCompletions": true,
    "python.condaPath": "C:\\ProgramData\\miniconda3\\Scripts\\conda.exe",
    "python.defaultInterpreterPath": "C:\\Users\\LabUser\\.conda\\envs\\cold-control\\python.exe",
    // The terminal profile activates Conda; avoid a second activation command.
    "python.terminal.activateEnvironment": false,
    "python-envs.terminal.autoActivationType": "off",
    "terminal.integrated.profiles.windows": {
        "Cold Control (Conda)": {
            "path": "C:\\Windows\\System32\\cmd.exe",
            "args": [
                "/D",
                "/K",
                "C:\\ProgramData\\miniconda3\\Scripts\\activate.bat",
                "cold-control"
            ]
        }
    },
    "terminal.integrated.defaultProfile.windows": "Cold Control (Conda)",
}
